@model Cliente

<section class="container mt-5">
        <section class="card">
            <section class="card-header">
                <h3>Confirmar Eliminación</h3>
            </section>
            <section class="card-body">
                <p>¿Estás seguro de que deseas eliminar al cliente <strong>@Model.Nombre</strong>?</p>
                <form asp-controller="Cliente" asp-action="EliminarCliente" method="post">
                    <input type="hidden" name="ClienteId" value="@Model.ClienteId" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <a asp-action="ListarClientes" asp-controller="Cliente" class="btn btn-secondary">Cancelar</a>
                </form>
            </section>
        </section>
</section>