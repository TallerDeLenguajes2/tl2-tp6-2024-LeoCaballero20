@model List<Cliente>

<div class="container mt-5">
        <h1 class="text-center mb-4">Lista de Clientes</h1>
        <table class="table table-striped table-bordered">
            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Opciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Cliente cliente in Model) {
                    <tr>
                    <td>@cliente.ClienteId</td>
                    <td>@cliente.Nombre</td>
                    <td>@cliente.Email</td>
                    <td>@cliente.Telefono</td>
                    <td>
                    <a class="btn btn-danger btn-sm" asp-controller="Cliente" asp-action="EliminarCliente" asp-route-id="@cliente.ClienteId">Eliminar</a>
                    </td>
                    </tr>
                }
            </tbody>
        </table>
</div>
<section class="mt-3 text-center">
    <a class="btn btn-success" asp-controller="Cliente" asp-action="CrearCliente">Agregar nuevo cliente</a>
</section>